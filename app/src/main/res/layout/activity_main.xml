<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Modern Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CivicSight"
            android:textSize="32sp"
            android:textColor="#111827"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI-Powered Hazard Reporting"
            android:textSize="15sp"
            android:textColor="#6B7280"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="32dp"/>

        <!-- Premium Image Placeholder -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E5E7EB"
            app:cardBackgroundColor="#F9FAFB">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="#D1D5DB" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Secondary Action: Outlined Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectImage"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            app:cornerRadius="12dp"
            app:strokeColor="#D1D5DB"
            android:textColor="#374151"
            android:text="1. Select Image / फोटो चुनें"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Primary Action: Solid Dark Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            app:backgroundTint="#111827"
            app:cornerRadius="12dp"
            android:textColor="#FFFFFF"
            android:text="2. Analyze Issue / विश्लेषण करें"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Alert/Final Action: Red Text Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendEmail"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:textColor="#DC2626"
            app:cornerRadius="12dp"
            android:text="3. Send Report / रिपोर्ट भेजें"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Sleek Loading Spinner -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:indeterminateTint="#111827"
            android:visibility="gone" />

        <!-- Minimalist Result Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F3F4F6">

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:text="AI Analysis will appear here...\nपरिणाम यहाँ दिखाई देगा..."
                android:textColor="#4B5563"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="6dp"/>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>